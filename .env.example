# Backend
APP_ENV=local
TACTIQ_CORS_ALLOW_ORIGINS=
OVERLAY_QUEUE_LIMIT=
COMMENTARY_MEMORY_MAX_LINES=
NARRATIVE_MIN_CONFIDENCE=
NARRATIVE_MIN_EVIDENCE_ITEMS=
TACTIQ_TEAM_A_NAME=
TACTIQ_TEAM_B_NAME=
TACTIQ_CLIP_PRE_ROLL_MS=
TACTIQ_CLIP_POST_ROLL_MS=
TACTIQ_CLIP_MAX_PER_MATCH=
TACTIQ_CLIP_MIN_CONFIDENCE=
TACTIQ_MEDIA_DIR=
TACTIQ_DATABASE_PATH=
TACTIQ_MAX_CACHED_MATCHES=32
VIDEO_UPLOAD_MAX_BYTES=209715200
TACTIQ_VIDEO_MAX_REDIRECTS=4
TACTIQ_JOB_WORKERS=2
TACTIQ_JOB_CAPACITY=8
TACTIQ_REQUESTS_PER_MINUTE=240
TACTIQ_EXPENSIVE_REQUESTS_PER_MINUTE=12

# Local mode is deliberately unauthenticated. Production requires configured token digests.
TACTIQ_AUTH_ENABLED=false
TACTIQ_API_TOKENS_JSON=[]
TACTIQ_COOKIE_SECURE=
TACTIQ_AUTH_COOKIE_NAME=tactiq_session

# Model files are operator-provided, never downloaded by an HTTP request.
# Video uploads/links default to CV. The events mode is an explicit non-authoritative motion preview.
# YouTube import uses the locked resolver/EJS packages and Node 22+; no cookies or provider secrets are needed.
TACTIQ_CV_DETECTOR=onnx
TACTIQ_CV_MODEL_PATH=
TACTIQ_CV_MODEL_SHA256=
TACTIQ_CV_MODEL_FORMAT=yolox
TACTIQ_CV_INPUT_SIZE=416
TACTIQ_CV_PERSON_CLASS_ID=0
TACTIQ_CV_BALL_CLASS_ID=32
TACTIQ_VALUE_MODEL_PATH=

# Foundry (optional enhancement; deterministic explanations remain available)
FOUNDRY_ENABLED=false
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_PROJECT_DEPLOYMENT_NAME=
AZURE_FOUNDRY_API_KEY=
FOUNDRY_COMMENTARY_PLAYBYPLAY_AGENT_NAME=
FOUNDRY_COMMENTARY_COLOR_AGENT_NAME=
FOUNDRY_COMMENTARY_PROMPT_TUNING_VERSION=
FOUNDRY_COMMENTARY_PLAYBYPLAY_PROFILE=
FOUNDRY_COMMENTARY_COLOR_PROFILE=
FOUNDRY_COMMENTARY_USE_DIRECT_AGENTS=
FOUNDRY_COMMENTARY_USE_AGENT_FRAMEWORK=false
FOUNDRY_COMMENTARY_AGENT_DESCRIPTION=

# Azure Speech
AZURE_TRANSLATOR_ENDPOINT=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_REGION=
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_FORCE_REST=true
AZURE_SPEECH_DEFAULT_VOICE=
AZURE_SPEECH_DEFAULT_VOICE_BY_LANGUAGE_JSON=
AZURE_SPEECH_DEFAULT_COMMENTATOR_A_VOICE=
AZURE_SPEECH_DEFAULT_COMMENTATOR_B_VOICE=
AZURE_SPEECH_DEFAULT_COMMENTATOR_PAIR_BY_LANGUAGE_JSON=
AZURE_SPEECH_COMMENTATOR_A_VOICE=
AZURE_SPEECH_COMMENTATOR_B_VOICE=

# Frontend
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ENABLE_CLOUD_SPEECH=
NEXT_PUBLIC_DEFAULT_PRIMARY_VOICE=
NEXT_PUBLIC_DEFAULT_SECONDARY_VOICE=
NEXT_PUBLIC_VOICE_PAIR_MAP_JSON=
TACTIQ_BACKEND_URL=

# Optional authenticated SLO watcher; webhook delivery is opt-in.
TACTIQ_MONITOR_API_URL=
TACTIQ_MONITOR_ACCESS_TOKEN=
TACTIQ_ALERT_WEBHOOK_URL=

# Optional distributed runtime. Missing cloud configuration fails closed, never to SQLite.
TACTIQ_RUNTIME_MODE=local
TACTIQ_PUBLIC_ORIGIN=
TACTIQ_POSTGRES_DSN=
TACTIQ_POSTGRES_MAX_CONNECTIONS=4
TACTIQ_IP_HMAC_KEY_HEX=
TACTIQ_TRUSTED_PROXY_CIDRS=
TACTIQ_CLOUD_ANALYSES_PER_DAY=disabled
TACTIQ_CLOUD_JOB_CAPACITY=8
TACTIQ_BLOB_ACCOUNT_URL=
TACTIQ_BLOB_CONTAINER=
AZURE_CLIENT_ID=
TACTIQ_SERVICEBUS_NAMESPACE=
TACTIQ_SERVICEBUS_QUEUE=
TACTIQ_WORKER_SCRATCH_ROOT=
TACTIQ_MICROSOFT_CLIENT_ID=
TACTIQ_MICROSOFT_CLIENT_SECRET=
TACTIQ_MICROSOFT_REDIRECT_URI=
TACTIQ_MICROSOFT_AUDIENCE=common

# Paid cloud generation additionally requires provider settings above and an approved allocation.
# Epoch seconds, microUSD limits, and microUSD per million tokens/characters are SERVER settings.
# No allowance/pricing is assumed; include unrelated subscription costs before approval.
TACTIQ_CLOUD_MODEL_ENABLED=false
TACTIQ_CLOUD_SPEECH_ENABLED=false
TACTIQ_AI_BUDGET_PERIOD_START=
TACTIQ_AI_BUDGET_PERIOD_END=
TACTIQ_AI_GLOBAL_LIMIT_MICROUSD=
TACTIQ_AI_TENANT_LIMIT_MICROUSD=
TACTIQ_MODEL_PRICE_MICROUSD_PER_MILLION_TOKENS=
TACTIQ_SPEECH_PRICE_MICROUSD_PER_MILLION_CHARACTERS=
